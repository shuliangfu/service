{
  "name": "@dreamer/service",
  "version": "1.0.1",
  "license": "Apache-2.0",
  "exports": { ".": "./src/mod.ts" },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/**/*.json",
      "LICENSE",
      "NOTICE",
      "README.md"
    ],
    "exclude": ["**/*.test.ts", "**/*.spec.ts", "**/test/**", "**/tests/**"]
  },
  "lint": {
    "include": ["src/"],
    "rules": { "tags": ["recommended"], "exclude": ["no-explicit-any"] }
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@dreamer/i18n": "jsr:@dreamer/i18n@^1.0.1",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.0.13",
    "@dreamer/test": "jsr:@dreamer/test@^1.0.8"
  },
  "allowScripts": {
    "allow": [],
    "deny": ["npm:esbuild@0.27.2", "npm:puppeteer@24.36.0"]
  }
}
